# Configuração do Apache/LiteSpeed (Hostinger) para o site estático gerado em out/.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Força HTTPS e remove o "www."
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Tipos de arquivo (a imagem de compartilhamento é gerada sem extensão)
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/calendar .ics
</IfModule>
<Files "opengraph-image">
  ForceType image/png
</Files>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Cache: arquivos de /_next/static têm hash no nome e podem ficar 1 ano;
# HTML sempre revalida, para que atualizações apareçam na hora.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
